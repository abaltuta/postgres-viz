{"format":"postgres-viz","version":1,"capturedAt":"2026-11-21T14:55:03.955Z","database":"routine_lab","schemas":{"include":null,"exclude":[]},"objects":[{"id":"f20167","schema":"ledger","name":"normalize_delta(input numeric)","kind":"function","detail":"sql returns numeric"},{"id":"f20168","schema":"ledger","name":"account_deltas(floor_amount numeric)","kind":"function","detail":"sql returns record"},{"id":"f20169","schema":"ledger","name":"post_deltas(IN minimum numeric, IN destination regclass)","kind":"procedure","detail":"plpgsql"},{"id":"k20151","parentId":"r20145","schema":"ledger","name":"accounts_pkey","kind":"constraint","detail":"PRIMARY KEY (id)"},{"id":"r20145","name":"accounts","kind":"table","schema":"ledger"},{"id":"r20152","name":"entries","kind":"table","schema":"ledger"},{"id":"r20157","name":"journal","kind":"table","schema":"ledger"},{"id":"r20162","name":"pending","kind":"table","schema":"ledger"}],"columns":[{"id":"c20145_1","objectId":"r20145","name":"id","type":"integer","position":1},{"id":"c20145_2","objectId":"r20145","name":"balance","type":"numeric","position":2},{"id":"c20145_3","objectId":"r20145","name":"note","type":"text","position":3},{"id":"c20152_1","objectId":"r20152","name":"account_id","type":"integer","position":1},{"id":"c20152_2","objectId":"r20152","name":"amount","type":"numeric","position":2},{"id":"c20152_3","objectId":"r20152","name":"memo","type":"text","position":3},{"id":"c20157_1","objectId":"r20157","name":"account_id","type":"integer","position":1},{"id":"c20157_2","objectId":"r20157","name":"previous_balance","type":"numeric","position":2},{"id":"c20162_1","objectId":"r20162","name":"delta","type":"numeric","position":1},{"id":"c20162_2","objectId":"r20162","name":"private_note","type":"text","position":2}],"relationships":[{"id":"calls|f20168|f20167","kind":"calls","source":"f20168","target":"f20167","provenance":"parsed"},{"id":"calls|f20169|f20167","kind":"calls","source":"f20169","target":"f20167","provenance":"parsed"},{"id":"calls|f20169|f20168","kind":"calls","source":"f20169","target":"f20168","provenance":"parsed"},{"id":"constrains|k20151|c20145_1","kind":"constrains","source":"k20151","target":"c20145_1","provenance":"catalog"},{"id":"inserts|f20169|c20157_1","kind":"inserts","source":"f20169","target":"c20157_1","provenance":"parsed"},{"id":"inserts|f20169|c20157_2","kind":"inserts","source":"f20169","target":"c20157_2","provenance":"parsed"},{"id":"reads|f20168|c20145_1","kind":"reads","source":"f20168","target":"c20145_1","provenance":"parsed"},{"id":"reads|f20168|c20152_1","kind":"reads","source":"f20168","target":"c20152_1","provenance":"parsed"},{"id":"reads|f20168|c20152_2","kind":"reads","source":"f20168","target":"c20152_2","provenance":"parsed"},{"id":"reads|f20169|c20145_1","kind":"reads","source":"f20169","target":"c20145_1","provenance":"parsed"},{"id":"reads|f20169|c20145_2","kind":"reads","source":"f20169","target":"c20145_2","provenance":"parsed"},{"id":"updates|f20169|c20145_2","kind":"updates","source":"f20169","target":"c20145_2","provenance":"parsed"}],"definitions":[{"ownerId":"f20168","sql":"CREATE OR REPLACE FUNCTION ledger.account_deltas(floor_amount numeric)\n RETURNS TABLE(account_key integer, delta numeric)\n LANGUAGE sql\n STABLE\nAS $function$\n  WITH totals(key, change) AS (\n    SELECT a.id, calc.amount\n    FROM ledger.accounts AS a\n    CROSS JOIN LATERAL (\n      SELECT sum(e.amount) AS amount\n      FROM ledger.entries AS e(owner)\n      WHERE e.owner = a.id\n    ) AS calc\n  )\n  SELECT t.account_key, ledger.normalize_delta(t.change)\n  FROM totals AS t(account_key)\n  WHERE t.change >= $1\n$function$\n"},{"ownerId":"f20167","sql":"CREATE OR REPLACE FUNCTION ledger.normalize_delta(input numeric)\n RETURNS numeric\n LANGUAGE sql\n IMMUTABLE\nAS $function$ SELECT round(input, 2) $function$\n"},{"ownerId":"f20169","sql":"CREATE OR REPLACE PROCEDURE ledger.post_deltas(IN minimum numeric, IN destination regclass)\n LANGUAGE plpgsql\nAS $procedure$\nDECLARE\n  cutoff ALIAS FOR $1;\n  pending record;\n  previous numeric;\nBEGIN\n  FOR pending IN\n    SELECT d.account_key, d.delta\n    FROM ledger.account_deltas(cutoff) AS d(account_key, delta)\n  LOOP\n    SELECT a.balance INTO STRICT previous\n    FROM ledger.accounts AS a WHERE a.id = pending.account_key;\n    UPDATE ledger.accounts AS a\n      SET balance = a.balance + ledger.normalize_delta(pending.delta)\n      WHERE a.id = pending.account_key;\n    EXECUTE 'INSERT INTO ledger.journal (account_id, previous_balance) VALUES ($1, $2)'\n      USING pending.account_key, previous;\n    IF destination IS NOT NULL THEN\n      EXECUTE format('INSERT INTO %s VALUES ($1)', destination) USING pending.delta;\n    END IF;\n  END LOOP;\nEND\n$procedure$\n"}],"evidence":[{"id":"e0","ownerId":"f20168","relationshipId":"reads|f20168|c20152_2","provenance":"parsed","snippet":"SELECT sum(e.amount) AS amount","start":291,"end":299},{"id":"e1","ownerId":"f20168","relationshipId":"reads|f20168|c20152_1","provenance":"parsed","snippet":"WHERE e.owner = a.id","start":361,"end":368},{"id":"e2","ownerId":"f20168","relationshipId":"reads|f20168|c20145_1","provenance":"parsed","snippet":"WHERE e.owner = a.id","start":371,"end":375},{"id":"e3","ownerId":"f20168","relationshipId":"reads|f20168|c20145_1","provenance":"parsed","snippet":"SELECT a.id, calc.amount","start":201,"end":205},{"id":"e4","ownerId":"f20168","relationshipId":"reads|f20168|c20152_2","provenance":"parsed","snippet":"SELECT a.id, calc.amount","start":207,"end":218},{"id":"e5","ownerId":"f20168","relationshipId":"reads|f20168|c20145_1","provenance":"parsed","snippet":"SELECT t.account_key, ledger.normalize_delta(t.change)","start":403,"end":416},{"id":"e6","ownerId":"f20168","relationshipId":"reads|f20168|c20152_2","provenance":"parsed","snippet":"SELECT t.account_key, ledger.normalize_delta(t.change)","start":441,"end":449},{"id":"e7","ownerId":"f20168","relationshipId":"reads|f20168|c20152_2","proven