[
  {
    "label": "postgres-viz: Open current snapshot",
    "command": "postgres-viz",
    "args": ["open", "\"$ZED_FILE\""]
  },
  {
    "label": "postgres-viz: Scan workspace database",
    "command": "postgres-viz",
    "args": ["scan", "--out", "database.pgviz.json"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
