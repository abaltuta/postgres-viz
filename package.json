{
  "name": "postgres-viz",
  "displayName": "Postgres Viz",
  "description": "Call-graph & dependency visualizer for PostgreSQL: triggers, views, PL/pgSQL functions, tables and columns.",
  "version": "0.5.1",
  "publisher": "baltuta",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:postgresVizExplorer"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "postgres-viz",
          "title": "Postgres Viz",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "postgres-viz": [
        {
          "id": "postgresVizExplorer",
          "name": "Database Objects",
          "icon": "$(database)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "postgresVizExplorer",
        "contents": "No database loaded yet.\n[Connect / Load](command:postgresViz.load)\nIntrospects the database and fills this tree and workspace symbols — without opening the graph.\n[Open Graph](command:postgresViz.visualize)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "postgresViz.visualize",
          "when": "view == postgresVizExplorer",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "postgresViz.searchGraph",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@1"
        },
        {
          "command": "postgresViz.chooseEdgeMode",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@2"
        },
        {
          "command": "postgresViz.viewOptions",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@3"
        },
        {
          "command": "postgresViz.facetedFilters",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@4"
        },
        {
          "command": "postgresViz.chooseLayout",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@5"
        },
        {
          "command": "postgresViz.fit",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@6"
        },
        {
          "command": "postgresViz.relayout",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@7"
        },
        {
          "command": "postgresViz.refreshGraph",
          "when": "activeWebviewPanelId == 'postgresViz'",
          "group": "navigation@8"
        }
      ],
      "view/item/context": [
        {
          "command": "postgresViz.treeFocus",
          "when": "view == postgresVizExplorer && viewItem =~ /^(table|view|matview|foreign|function|column|trigger|constraint|index|schema)$/",
          "group": "inline"
        },
        {
          "command": "postgresViz.treeFocus",
          "when": "view == postgresVizExplorer && viewItem =~ /^(table|view|matview|foreign|function|column|trigger|constraint|index|schema)$/",
          "group": "navigation@1"
        },
        {
          "command": "postgresViz.treeCallTree",
          "when": "view == postgresVizExplorer && viewItem =~ /^(function|trigger)$/",
          "group": "navigation@2"
        },
        {
          "command": "postgresViz.treeGoToDef",
          "when": "view == postgresVizExplorer && viewItem =~ /^(table|view|matview|foreign|function|column|trigger|constraint|index)$/",
          "group": "navigation@3"
        },
        {
          "command": "postgresViz.treeOpenDdl",
          "when": "view == postgresVizExplorer && viewItem =~ /^(table|view|matview|foreign|function|column|trigger|constraint|index)$/",
          "group": "navigation@4"
        },
        {
          "command": "postgresViz.impactAnalysis",
          "when": "view == postgresVizExplorer && viewItem =~ /^(table|view|matview|foreign|function|column|trigger|constraint|index)$/",
          "group": "navigation@5"
        },
        {
          "command": "postgresViz.findPath",
          "when": "view == postgresVizExplorer && viewItem =~ /^(table|view|matview|foreign|function|column|trigger|constraint|index)$/",
          "group": "navigation@6"
        }
      ]
    },
    "keybindings": [
      {
        "command": "postgresViz.searchGraph",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'postgresViz'"
      },
      {
        "command": "postgresViz.fit",
        "key": "alt+f",
        "when": "activeWebviewPanelId == 'postgresViz'"
      },
      {
        "command": "postgresViz.relayout",
        "key": "alt+l",
        "when": "activeWebviewPanelId == 'postgresViz'"
      }
    ],
    "commands": [
      {
        "command": "postgresViz.visualize",
        "title": "Postgres Viz: Visualize Database",
        "icon": "$(graph)"
      },
      {
        "command": "postgresViz.load",
        "title": "Postgres Viz: Connect / Load Database",
        "icon": "$(plug)"
      },
      {
        "command": "postgresViz.showLogs",
        "title": "Postgres Viz: Show Logs"
      },
      {
        "command": "postgresViz.showLoadDiagnostics",
        "title": "Postgres Viz: Show Load Diagnostics",
        "icon": "$(pulse)"
      },
      {
        "command": "postgresViz.connectionMenu",
        "title": "Postgres Viz: Connection Actions",
        "icon": "$(database)"
      },
      {
        "command": "postgresViz.searchGraph",
        "title": "Postgres Viz: Search Graph",
        "icon": "$(search)"
      },
      {
        "command": "postgresViz.chooseEdgeMode",
        "title": "Postgres Viz: Edge Mode",
        "icon": "$(git-compare)"
      },
      {
        "command": "postgresViz.viewOptions",
        "title": "Postgres Viz: View Options",
        "icon": "$(filter)"
      },
      {
        "command": "postgresViz.facetedFilters",
        "title": "Postgres Viz: Faceted Filters",
        "icon": "$(list-filter)"
      },
      {
        "command": "postgresViz.chooseLayout",
        "title": "Postgres Viz: Choose Layout",
        "icon": "$(layout)"
      },
      {
        "command": "postgresViz.fit",
        "title": "Postgres Viz: Fit Graph",
        "icon": "$(screen-full)"
      },
      {
        "command": "postgresViz.relayout",
        "title": "Postgres Viz: Re-run Layout",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "postgresViz.refreshGraph",
        "title": "Postgres Viz: Refresh From Database",
        "icon": "$(sync)"
      },
      {
        "command": "postgresViz.treeFocus",
        "title": "Focus",
        "icon": "$(target)"
      },
      {
        "command": "postgresViz.treeCallTree",
        "title": "Call Tree",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "postgresViz.treeGoToDef",
        "title": "Go to Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "postgresViz.treeOpenDdl",
        "title": "Open DDL",
        "icon": "$(file-code)"
      },
      {
        "command": "postgresViz.impactAnalysis",
        "title": "Postgres Viz: Impact Analysis",
        "icon": "$(references)"
      },
      {
        "command": "postgresViz.findPath",
        "title": "Postgres Viz: Find Dependency Path",
        "icon": "$(symbol-event)"
      },
      {
        "command": "postgresViz.saveSnapshot",
        "title": "Postgres Viz: Save Graph Snapshot",
        "icon": "$(save)"
      },
      {
        "command": "postgresViz.diffSnapshot",
        "title": "Postgres Viz: Compare With Saved Snapshot",
        "icon": "$(diff)"
      },
      {
        "command": "postgresViz.exportGraphJson",
        "title": "Postgres Viz: Export Graph JSON",
        "icon": "$(json)"
      },
      {
        "command": "postgresViz.exportGraphPng",
        "title": "Postgres Viz: Export Graph PNG",
        "icon": "$(file-media)"
      },
      {
        "command": "postgresViz.exportGraphSvg",
        "title": "Postgres Viz: Export Graph SVG",
        "icon": "$(file-code)"
      }
    ],
    "configuration": {
      "title": "Postgres Viz",
      "properties": {
        "postgresViz.schemas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Schemas to introspect. Empty = all non-system schemas."
        },
        "postgresViz.excludeSchemas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "hdb_catalog"
          ],
          "description": "Schemas to skip when no whitelist is set (PG internals and extension-owned objects are always skipped)."
        },
        "postgresViz.includeForeignKeys": {
          "type": "boolean",
          "default": true,
          "description": "Include foreign-key edges in the graph."
        },
        "postgresViz.hclExcludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.baltuta/**",
            "**/openspec/**"
          ],
          "description": "Glob patterns excluded when scanning the workspace for Atlas .hcl schema files (node_modules and .git are always excluded)."
        },
        "postgresViz.sqlMigrationExcludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.baltuta/**",
            "**/openspec/**"
          ],
          "description": "Glob patterns excluded when scanning the workspace for folder/up.sql migrations (node_modules and .git are always excluded)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "lint": "oxlint src webview test scripts",
    "format": "oxfmt src webview test scripts esbuild.mjs",
    "smoke": "node esbuild.mjs --smoke && node dist-test/smoke.js && node dist-test/db.js && node dist-test/ddl.js && node dist-test/connection-profiles.js && node dist-test/load-service.js && node dist-test/protocol.js && node dist-test/parser-worker-ipc.js && node dist-test/graph-diff.js && node dist-test/graph-index.js && node dist-test/graph-reports.js && node dist-test/tree-model.js && node dist-test/tree-provider.js && node dist-test/webview.js && node dist-test/webview-controller.js && node dist-test/hcl.js && node dist-test/sql-migrations.js && node dist-test/match.js && node dist-test/lenses.js && node dist-test/lens-providers.js && node dist-test/ddl-symbols.js && node dist-test/ddl-symbol-provider.js",
    "test:db": "node esbuild.mjs --smoke && node dist-test/integration.js",
    "test:db:docker": "node scripts/test-db.mjs",
    "package": "pnpm build && vsce package --no-dependencies"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "pg-query-emscripten": "^5.1.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/vscode": "^1.125.0",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/vsce": "^3.9.2",
    "cytoscape": "^3.34.0",
    "dagre": "^0.8.5",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^6.0.3"
  }
}
