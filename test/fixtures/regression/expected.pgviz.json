S trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE supports boolean;\nBEGIN\n  SELECT i.status IS NOT NULL INTO supports\n  FROM payroll.instruction i WHERE i.id = NEW.id;\n  IF NOT supports AND NEW.proration = true THEN\n    NEW.proration := false;\n  END IF;\n  RETURN NEW;\nEND $function$\n"},{"ownerId":"f17239","sql":"CREATE OR REPLACE FUNCTION payroll.entry_amount(entry payroll.report_entry)\n RETURNS numeric\n LANGUAGE sql\n IMMUTABLE\nAS $function$SELECT entry.amount$function$\n"},{"ownerId":"f17241","sql":"CREATE OR REPLACE FUNCTION payroll.payrun_status(payrun payroll.payrun)\n RETURNS text\n LANGUAGE plpgsql\n STABLE\nAS $function$\nDECLARE\n  cutoff date := payrun.cutoff_date;\n  needs_review boolean;\nBEGIN\n  needs_review := EXISTS (\n    SELECT 1\n    FROM payroll.instruction i\n    WHERE i.recurring_payrun_id = payrun.recurring_id\n      AND i.status = 'NEEDS_REVIEW'\n  );\n  RETURN (\n    SELECT CASE\n      WHEN needs_review AND CURRENT_DATE > cutoff THEN 'OVERDUE'\n      WHEN NOT needs_review AND (CURRENT_DATE > cutoff OR payrun.finalized_at IS NOT NULL)\n        THEN 'COMPLETED'\n      ELSE 'IN_PROGRESS'\n    END\n  );\nEND $function$\n"},{"ownerId":"f17240","sql":"CREATE OR REPLACE FUNCTION payroll.recalculate_totals(report_id uuid)\n RETURNS void\n LANGUAGE sql\nAS $function$\nWITH deleted AS (\n  DELETE FROM payroll.employee_totals\n  WHERE payroll_report_id = report_id\n  RETURNING employee_id\n),\ncomputed AS (\n  SELECT\n    e.payroll_report_id,\n    e.employee_id,\n    p.paycode_type,\n    SUM(payroll.entry_amount(e)) AS computed_total\n  FROM payroll.report_entry e\n  JOIN payroll.paycode p ON e.payroll_paycode_id = p.id\n  WHERE e.payroll_report_id = report_id\n    AND p.exclude_from_validation = FALSE\n  GROUP BY e.payroll_report_id, e.employee_id, p.paycode_type\n)\nINSERT INTO payroll.employee_totals (payroll_report_id, employee_id, paycode_type, computed_total)\nSELECT t.payroll_report_id, t.employee_id, t.paycode_type, COALESCE(t.computed_total, 0)\nFROM computed t;\n$function$\n"},{"ownerId":"f17196","sql":"CREATE OR REPLACE FUNCTION public.alias_gauntlet()\n RETURNS SETOF text\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  RETURN QUERY\n  WITH recent(cid, amount) AS (\n    SELECT o.customer_id, o.total FROM orders o\n  ),\n  named AS (\n    SELECT c.email AS contact FROM customers c\n  )\n  SELECT n.contact\n  FROM named n\n  JOIN (SELECT r.cid FROM recent r WHERE r.amount > 10) rc ON rc.cid > 0\n  WHERE EXISTS (\n    SELECT 1 FROM customers cc WHERE cc.id = rc.cid AND cc.name <> n.contact\n  );\nEND $function$\n"},{"ownerId":"f17060","sql":"CREATE OR REPLACE FUNCTION public.ambiguous_sum_call()\n RETURNS bigint\n LANGUAGE sql\nAS $function$ SELECT child_sum() $function$\n"},{"ownerId":"f17058","sql":"CREATE OR REPLACE FUNCTION public.child_sum()\n RETURNS bigint\n LANGUAGE sql\nAS $function$ SELECT sum(x) FROM public.\"Child.Key\" $function$\n"},{"ownerId":"f17059","sql":"CREATE OR REPLACE FUNCTION public.child_sum(integer)\n RETURNS integer\n LANGUAGE sql\nAS $function$ SELECT $1 $function$\n"},{"ownerId":"f17197","sql":"CREATE OR REPLACE FUNCTION public.collision_check()\n RETURNS integer\n LANGUAGE plpgsql\nAS $function$\nDECLARE x int;\nBEGIN\n  SELECT count(*) INTO x FROM (\n    SELECT t.total FROM orders t\n  ) a JOIN (\n    SELECT t.email FROM customers t\n  ) b ON true;\n  RETURN x;\nEND $function$\n"},{"ownerId":"f17171","sql":"CREATE OR REPLACE FUNCTION public.log_order()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n  order_count int;\nBEGIN\n  SELECT count(*) INTO order_count FROM orders o WHERE o.customer_id = NEW.customer_id;\n  INSERT INTO audit_log (table_name, payload) VALUES ('orders', to_jsonb(NEW));\n  UPDATE customers SET name = name WHERE id = NEW.customer_id;\n  PERFORM notify_stats();\n  RETURN NEW;\nEND $function$\n"},{"ownerId":"f17174","sql":"CREATE OR REPLACE FUNCTION public.non_negative(n numeric)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\nAS $function$SELECT n >= 0$function$\n"},{"ownerId":"f17170","sql":"CREATE OR REPLACE FUNCTION public.notify_stats()\n RETURNS void\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  PERFORM pg_notify('stats', '');\nEND $function$\n"},{"ownerId":"f17163","sql":"CREATE OR REPLACE FUNCTION public.rule_note()\n RETURNS text\n LANGUAGE sql\nAS $function$ SELECT 'from rule' $function$\n"},{"ownerId":"f17065","sql":"CREATE OR REPLACE FUNCTION public.set_current_timestamp_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE _new record;\nBEGIN\n  _new := NEW;\n  _new.\"updated_at\" = NOW();\n  RETURN _new;\nEND $function$\n"},{"ownerId":"f17173","sql":"CREATE OR REPLACE FUNCTION public.total_for(cid bigint)\n RETURNS numeric\n LANGUAGE sql\nBEGIN ATOMIC\n SELECT COALESCE(sum(orders.total), (0)::numeric) AS \"coalesce\"\n    FROM orders\n   WHERE (orders.customer_id = total_for.cid);\nEND\n"},{"ownerId":"f17198","sql":"CREATE OR REPLACE FUNCTION public.touch_customer(cid bigint)\n RETURNS void\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  UPDATE customers AS tgt SET email = tgt.name WHERE tgt.id = cid;\nEND $function$\n"},{"ownerId":"r17061","sql":" SELECT child_sum() AS total;"},{"ownerId":"r17141","sql":" SELECT c.name,\n    o.total\n   FROM customers c\n     JOIN orders o ON o.customer_id = c.id;"},{"ownerId":"r17145","sql":" SELECT customer_id,\n    sum(total) AS sum_total\n   FROM orders\n  GROUP BY customer_id;"},{"ownerId":"r17165","sql":" SELECT id\n   FROM rule_target;"}],"evidence":[{"id":"e0","ownerId":"f17239","relationshipId":"reads|f17239|c17208_5","provenance":"parsed","snippet":"SELECT entry.amount","start":138,"end":150},{"id":"e1","ownerId":"f17241","relationshipId":"reads|f17241|c17225_3","provenance":"parsed","snippet":"payrun.cutoff_date","start":151,"end":169},{"id":"e2","ownerId":"f17241","relationshipId":"reads|f17241|c17230_2","provenance":"parsed","snippet":"WHERE i.recurring_payrun_id = payrun.recurring_id","start":282,"end":303},{"id":"e3","